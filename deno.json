{
  "compilerOptions": {
    "exactOptionalPropertyTypes": true,
    "lib": ["deno.ns", "dom", "dom.iterable", "esnext"],
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "strict": true
  },
  "fmt": {
    "include": [
      ".github/workflows/",
      ".plans/",
      "CLAUDE.md",
      "HANDOVER.md",
      "README.md",
      "deno.json",
      "docs/adr/",
      "index.html",
      "justfile",
      "release-please-config.json",
      "renovate.json",
      "scripts/",
      "src/",
      "tests/"
    ],
    "indentWidth": 2,
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "rules": {}
  },
  "imports": {
    "playwright": "npm:playwright@1.64.1"
  },
  "tasks": {
    "setup": "deno run --allow-read --allow-write --allow-env --allow-run scripts/setup.ts",
    "check": "deno fmt --check && deno lint && deno check src/main.ts scripts/build.ts scripts/setup.ts scripts/serve.ts scripts/check_pr_title.ts scripts/install_playwright.ts",
    "check:pr-title": "deno run scripts/check_pr_title.ts",
    "install:chromium": "deno run --allow-read=deno.json --allow-run scripts/install_playwright.ts",
    "test": "deno test --allow-read tests/domain_behavior_test.ts tests/pr_title_behavior_test.ts tests/tooling_behavior_test.ts",
    "test:honeycomb": "deno task build && deno test -A tests/honeycomb_behavior_test.ts",
    "build": "deno run --allow-read --allow-write --allow-run scripts/build.ts",
    "ci": "deno task check && deno task test && deno task build",
    "serve": "deno task build && deno run --allow-read=dist --allow-net=127.0.0.1:8080 scripts/serve.ts"
  }
}
